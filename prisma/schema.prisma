// ElectroShop-Tech Database Schema
// PostgreSQL on Neon

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Products ──────────────────────────────────────────────────────────────────

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  originalPrice Float
  currentPrice  Float
  image         String
  badge         String?
  isRefurbished Boolean  @default(false)
  category      String
  brand         String
  slug          String   @unique
  sku           String?
  condition     String?
  guarantee     String?
  inStock       Boolean  @default(true)
  stockQuantity Int      @default(0)

  // SEO overrides
  metaTitle       String?
  metaDescription String?

  specs               String[]  // array of spec strings
  images              String[]  // array of image URLs
  descriptionSections Json?     // stored as JSON array
  characteristics     Json?     // stored as JSON array
  productReviews      Json?     // stored as JSON array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
  @@index([brand])
}

// ── Categories ────────────────────────────────────────────────────────────────

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique
  icon String @default("")

  // SEO overrides
  metaTitle       String?
  metaDescription String?
}

// ── Brands ────────────────────────────────────────────────────────────────────

model Brand {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique
}

// ── Hero Slides ───────────────────────────────────────────────────────────────

model HeroSlide {
  id          Int    @id @default(autoincrement())
  title       String
  subtitle    String
  badge       String
  discount    String
  price       String
  href        String
  bgColor     String
  accentColor String
}

// ── Site Reviews (testimonials) ───────────────────────────────────────────────

model Review {
  id      Int    @id @default(autoincrement())
  author  String
  role    String
  content String
  rating  Int
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatar       String?

  // Address fields (flat — no need for a separate table)
  addressStreet     String?
  addressCity       String?
  addressPostalCode String?
  addressCountry    String?

  // Password reset
  resetToken   String?  @unique
  resetExpiry  DateTime?

  createdAt DateTime @default(now())

  orders Order[]
}

// ── Orders ────────────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  orderNumber    String?     @unique
  userId         String
  customerName   String
  customerEmail  String
  customerPhone  String?
  subtotal       Float
  total          Float
  status         OrderStatus   @default(PENDING)
  paymentMethod  String
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime?
  notes          String?
  trackingNumber String?
  promoCode      String?
  promoDiscount  Float     @default(0)

  // Address (flat)
  addressStreet     String
  addressCity       String
  addressPostalCode String
  addressCountry    String  @default("Maroc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      String
  productId    Int
  productName  String
  productImage String
  quantity     Int
  price        Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ── Abandoned carts ───────────────────────────────────────────────────────────

model AbandonedCart {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String?
  email      String?
  customerName String?
  phone      String?
  items      Json
  subtotal   Float    @default(0)
  itemCount  Int      @default(0)
  recovered  Boolean  @default(false)
  reminded   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([recovered])
  @@index([updatedAt])
}

// ── Newsletter ────────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  unsubscribeToken String  @unique @default(cuid())
  subscribedAt    DateTime @default(now())
}

// ── Promotions ────────────────────────────────────────────────────────────────

model Promo {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  type      String   @default("percent") // "percent" | "fixed"
  value     Float
  minOrder  Float    @default(0)
  uses      Int      @default(0)
  maxUses   Int      @default(100)
  active    Boolean  @default(true)
  expires   DateTime
  createdAt DateTime @default(now())
}

// ── Site Settings ─────────────────────────────────────────────────────────────

model SiteSetting {
  key   String @id
  value String
}

// ── Admin Activity Log ─────────────────────────────────────────────────────────

model AdminLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g. "product.create", "order.status", "settings.update"
  detail    String   // human-readable description
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Delivery Zones ────────────────────────────────────────────────────────────

model DeliveryZone {
  id     Int    @id @default(autoincrement())
  name   String
  cities String[] // list of city names
  fee    Float
  active Boolean @default(true)
}

// ── Page View Tracking ────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  url       String
  referrer  String   @default("")
  ua        String   @default("")
  sessionId String
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([sessionId])
}

// ── Returns / Refunds ───────────────────────────────────────────────

model Return {
  id            String   @id @default(cuid())
  orderId       String
  customerName  String
  customerEmail String
  customerPhone String?
  reason        String
  comment       String?
  status        String   @default("pending") // pending | approved | rejected | refunded
  refundAmount  Float    @default(0)
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

// ── Contact Messages ───────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

// ── Back-in-stock notifications ────────────────────────────────────

model StockNotification {
  id        Int      @id @default(autoincrement())
  productId Int
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, email])
  @@index([productId])
  @@index([notified])
}

// ── Admin / Staff accounts ───────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("staff") // owner | manager | staff
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
}

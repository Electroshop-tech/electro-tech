# ─────────────────────────────────────────────────────────────────────────────
# ElectroShop-Tech — Environment variables
# Copy this file to `.env.local` (development) and set the same values in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# Never commit your real `.env.local` — only this example file is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# PostgreSQL connection string (Neon). Used by Prisma + the seed script.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Authentication (REQUIRED — no safe defaults) ─────────────────────────────
# Strong random string used to sign JWT session tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your-secure-random-secret-min-32-chars
# Password for the admin panel login (/admin).
ADMIN_PASSWORD=your-strong-admin-password

# ── Site URL (REQUIRED in production) ────────────────────────────────────────
# Public base URL, no trailing slash. Used in emails, invoices and SEO.
NEXT_PUBLIC_SITE_URL=https://electroshop-tech.com
# Base URL for OAuth redirects (falls back to VERCEL_URL / localhost).
NEXT_PUBLIC_BASE_URL=https://electroshop-tech.com

# ── Email — Resend (REQUIRED for order/contact emails) ───────────────────────
# API key from https://resend.com/api-keys . If missing, emails are skipped.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender. The domain must be verified in the Resend dashboard.
RESEND_FROM=ElectroShop-Tech <commandes@electroshop-tech.com>
# Where admin notifications (new orders) are sent.
ADMIN_EMAIL=your-admin@email.com
# Where contact-form messages are sent.
CONTACT_EMAIL=contact@electroshop-tech.com

# ── Payments (OPTIONAL — not yet live, COD only for now) ─────────────────────
# Secret used to verify incoming payment provider webhooks.
PAYMENT_WEBHOOK_SECRET=

# ── Google sign-in (OPTIONAL) ────────────────────────────────────────────────
# If unset, the "Sign in with Google" button is hidden automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
